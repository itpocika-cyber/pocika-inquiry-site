# Server Runtime & Port (Render assigns PORT automatically in production)
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pocika_inquiry_system?retryWrites=true&w=majority

# JWT Authentication Secret (Used for signing & verifying auth tokens)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# CORS Allowed Origins (Comma-separated for multiple origins, e.g. Vercel production + preview + localhost)
CLIENT_ORIGIN=https://your-pocika-frontend.vercel.app,http://localhost:5173

# Cloudinary Media Layer (Sole Image & Media Storage Provider)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK (Disabled by default - kept for future decision)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=pocika-sales-inquiry-system
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@pocika-sales-inquiry-system.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
