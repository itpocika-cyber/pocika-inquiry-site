PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pocika_inquiry_system?retryWrites=true&w=majority
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Firebase Admin SDK Credentials (Server Side Only - NEVER expose to frontend)
FIREBASE_PROJECT_ID=pocika-sales-inquiry-system
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@pocika-sales-inquiry-system.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary Media Layer (Sole Image and Media Storage Provider)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
